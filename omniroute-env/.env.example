# OmniRoute Local AI Gateway Configuration
OMNIROUTE_PORT=20128
OMNIROUTE_SERVER_HOST=0.0.0.0
OMNIROUTE_DEFAULT_MODEL=auto
OMNIROUTE_FALLBACK_MODEL=kimi-k3

# Claude Code Routing Configuration
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_AUTH_TOKEN=your-omniroute-token-or-dummy
ANTHROPIC_API_KEY=your-omniroute-token-or-dummy
ANTHROPIC_MODEL=auto

# OpenAI Compatible Tools Configuration
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=your-omniroute-token-or-dummy
OPENAI_MODEL=auto
