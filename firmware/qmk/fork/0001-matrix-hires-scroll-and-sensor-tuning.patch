+#ifdef POINTING_DEVICE_HIRES_SCROLL_ENABLE
+// Resolution Multiplier feature of the mouse (the host writes 1 to read the
+// wheel in 1/POINTING_DEVICE_HIRES_SCROLL_MULTIPLIER notches). Until it does,
+// wheel values are whole notches, so the sender must check this.
+static volatile uint8_t hires_scroll_feature = 0;
+static uint8_t _Alignas(4) hires_scroll_buf[2];
+
+bool usb_hires_scroll_enabled(void) {
+    return (hires_scroll_feature & 0x03) != 0;
+}
+
+uint8_t usb_hires_scroll_feature_value(void) {
+    return hires_scroll_feature;
+}
+
+static void set_hires_scroll_transfer_cb(USBDriver *usbp) {
+    usb_control_request_t *setup = (usb_control_request_t *)usbp->setup;
+#    ifdef MOUSE_SHARED_EP
+    // [report ID, value]
+    if (setup->wLength >= 2 && hires_scroll_buf[0] == REPORT_ID_MOUSE) hires_scroll_feature = hires_scroll_buf[1];
+#    else
+    if (setup->wLength >= 1) hires_scroll_feature = hires_scroll_buf[0];
+#    endif
+}
+#endif
+
