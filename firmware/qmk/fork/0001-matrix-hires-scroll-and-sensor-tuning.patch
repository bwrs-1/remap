diff --git a/drivers/sensors/maxtouch.c b/drivers/sensors/maxtouch.c
index 0b3efdd..12cf223 100644
--- a/drivers/sensors/maxtouch.c
+++ b/drivers/sensors/maxtouch.c
@@ -199,6 +199,24 @@ static uint16_t              t100_subsequent_report_ids[DIGITIZER_CONTACT_COUNT]
 static uint16_t              t100_num_reports                                    = 0;
 static mxt_information_block information                                         = {0};
 
+// Runtime tuning (Matrix editor): rewrites single T100 fields in the
+// controller's RAM configuration; maxtouch_init() writes the defaults again
+// after a reset. 0xFF / 0xFFFF leave a field unchanged.
+void maxtouch_tune(uint8_t touch_threshold, uint16_t move_hysteresis_initial, uint16_t move_hysteresis_next) {
+    if (!t100_multiple_touch_touchscreen_address) return;
+    if (touch_threshold != 0xFF) {
+        i2c_write_register16(MXT336UD_ADDRESS, t100_multiple_touch_touchscreen_address + offsetof(mxt_touch_multiscreen_t100, tchthr), &touch_threshold, 1, MXT_I2C_TIMEOUT_MS);
+    }
+    if (move_hysteresis_initial != 0xFFFF) {
+        uint8_t v[2] = {move_hysteresis_initial & 0xFF, move_hysteresis_initial >> 8}; // little endian
+        i2c_write_register16(MXT336UD_ADDRESS, t100_multiple_touch_touchscreen_address + offsetof(mxt_touch_multiscreen_t100, movhysti), v, 2, MXT_I2C_TIMEOUT_MS);
+    }
+    if (move_hysteresis_next != 0xFFFF) {
+        uint8_t v[2] = {move_hysteresis_next & 0xFF, move_hysteresis_next >> 8};
+        i2c_write_register16(MXT336UD_ADDRESS, t100_multiple_touch_touchscreen_address + offsetof(mxt_touch_multiscreen_t100, movhystn), v, 2, MXT_I2C_TIMEOUT_MS);
+    }
+}
+
 void maxtouch_print_info(void) {
     // Pavonis: Found MXT 164:75, fw 16.170 with 32 objects. Matrix size 41x26
     uprintf("Found MXT %d:%d, fw %d.%d with %d objects. Matrix size %dx%d\n", information.family_id, information.variant_id, information.version, information.build, information.num_objects, information.matrix_x_size, information.matrix_y_size);
